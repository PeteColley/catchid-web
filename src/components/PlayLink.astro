---
import { getPlayUrl, type PlayCampaign } from '../config';
interface Props { compact?: boolean; light?: boolean; campaign?: PlayCampaign }
const { compact = false, light = false, campaign = 'website_launch' } = Astro.props;
---
<a class:list={['play-link', { compact, light }]} href={getPlayUrl(campaign)}>
  <span>{compact ? 'Get the Android app' : 'Get CatchID on Google Play'}</span>
  <span aria-hidden="true">↗</span>
</a>
