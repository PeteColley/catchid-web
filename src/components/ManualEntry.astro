---
import CapturedScreen from './CapturedScreen.astro';
import saveCatch from '../../docs/CID-WEB-CRO-07/captures/save-catch-no-photo-upper-1080x2340.png';

---
<section class="record-section wrap" id="record">
<div class="record-copy">
<p class="eyebrow">01 / RECORD EVERY CATCH</p>
<h2>A photo is optional.<br>
<em>The memory isn’t.</em>
</h2>
<p>Add a catch yourself, with or without a photo. Keep the details you want to remember.</p>
<dl class="field-list">
<div>
<dt>The fish</dt>
<dd>Species &amp; weight</dd>
</div>
<div>
<dt>The moment</dt>
<dd>Date, time &amp; location</dd>
</div>
<div>
<dt>The details</dt>
<dd>Method, bait, lure or fly</dd>
</div>
</dl>
</div>
<figure class="entry-proof">
<span class="figure-heading">Save catch · upper form</span>
<CapturedScreen src={saveCatch} alt="Actual Save catch upper form excerpt: no photo recorded, Brown Trout, date and time, optional Riverside location and Fly method. The form continues below; the Save button is not shown." />
<figcaption>Actual CatchID UI · Controlled demonstration data · No photo required<br><span>Upper form excerpt · continues below</span></figcaption>
</figure>
</section>
<style>
  .entry-proof { width: 100%; max-width: 440px; justify-self: center; padding: 24px; }
  .entry-proof figcaption { font-size: 12px; line-height: 1.6; }
  .entry-proof figcaption span { display: inline-block; margin-top: 4px; }
  @media (min-width: 761px) and (max-width: 900px) {
    .record-section { display: flex; flex-direction: column; gap: 34px; }
    .record-copy { width: 100%; max-width: 560px; }
  }
  @media (max-width: 760px) {
    .entry-proof { width: calc(100% + 16px); max-width: 390px; align-self: center; margin-inline: 0; padding: 0; background: transparent; }
  }
</style>
