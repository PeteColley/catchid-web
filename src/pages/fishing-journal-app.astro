---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Download from '../components/Download.astro';
import WebAnalyticsConsent from '../components/WebAnalyticsConsent.astro';
import ProductCrop from '../components/ProductCrop.astro';
import Insights from '../components/Insights.astro';
import Identification from '../components/Identification.astro';
import Trust from '../components/Trust.astro';
import FAQ from '../components/FAQ.astro';
const campaign='fishing_journal_app';
---
<SiteLayout title="Fishing Journal App for Android | CatchID" description="Keep catches, photos and fishing details together. CatchID is a free Android fishing journal with manual recording, optional fish identification and Catch Insights." path="/fishing-journal-app/" pageClass="landing-page">
<div class="landing-top">
<SiteHeader landing />
</div>
<main id="main" tabindex="-1">
<div class="landing-top">
<section class="landing-hero wrap">
<div class="hero-copy">
<p class="eyebrow">THE CATCHID FISHING JOURNAL APP</p>
<h1>Your catches.<br>Your details.<br>
<em>Your journal.</em>
</h1>
<p class="hero-description">
<span class="desktop-promise">A fishing journal app for the catches you want to remember. Log manually, add a photo if you have one, and keep your fishing history together.</span>
<span class="mobile-promise">Log catches, with or without a photo. Keep your fishing history together.</span>
</p>
<Download campaign={campaign} priority />
<a class="text-link" href="#record">See how to log a catch <span aria-hidden="true">↓</span>
</a>
</div>
<div class="landing-proof">
<div class="landing-paper">
<span>YOUR FISHING HISTORY</span>
<p>Catch by catch.<br>Day by day.</p>
</div>
<div class="screen journal-screen ">
<ProductCrop name="journal.jpg" box="75 205 930 1655" width={1080} height={1920} alt="Catch Journal from existing published artwork: saved carp, dace and trout with dates and fishing details." class="" />
</div>
<span class="proof-caption">Catch Journal · existing published artwork</span>
</div>
</section>
<div class="consent-wrap wrap">
<WebAnalyticsConsent />
</div>
</div>
<section class="journal-guide wrap" id="record">
<div class="guide-title">
<p class="eyebrow">FROM THE WATER TO YOUR JOURNAL</p>
<h2>Make a record.<br>
<em>Make it yours.</em>
</h2>
</div>
<ol class="steps">
<li>
<span>01</span>
<h3>Start with the catch</h3>
<p>Choose “Add without a photo” to record manually. You don’t need fish identification.</p>
</li>
<li>
<span>02</span>
<h3>Keep the details</h3>
<p>Save species, date, time, location, weight and fishing details where available.</p>
</li>
<li>
<span>03</span>
<h3>Come back to the day</h3>
<p>Find your saved catches in one journal, with the photographs and details you recorded.</p>
</li>
</ol>
<figure class="guide-entry">
<ProductCrop name="home-1.2.12.png" box="38 232 705 458" width={780} height={1688} alt="Actual CatchID entry controls, including Add without a photo." class="" />
<figcaption>Manual entry begins here · genuine app crop</figcaption>
</figure>
<div class="guide-note">
<h3>Camera stayed in your pocket?</h3>
<p>Your catch still belongs in your journal. A photograph is optional.</p>
</div>
</section>
<Insights landing />
<Identification />
<Trust />
<section class="faq-section" id="questions">
<FAQ landing />
<div class="final-invite wrap" id="download">
<div>
<p class="eyebrow">YOUR NEXT CATCH IS A BEGINNING</p>
<h2>Start your<br>
<em>fishing journal.</em>
</h2>
</div>
<Download campaign={campaign}  />
</div>
</section>
</main>
<SiteFooter />
</SiteLayout>
