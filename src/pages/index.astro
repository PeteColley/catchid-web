---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Download from '../components/Download.astro';
import WebAnalyticsConsent from '../components/WebAnalyticsConsent.astro';
import ProductCrop from '../components/ProductCrop.astro';
import HeroPhoto from '../components/HeroPhoto.astro';
import ManualEntry from '../components/ManualEntry.astro';
import JournalStory from '../components/JournalStory.astro';
import Insights from '../components/Insights.astro';
import Identification from '../components/Identification.astro';
import Trust from '../components/Trust.astro';
import FAQ from '../components/FAQ.astro';
const campaign='website_launch';
---
<SiteLayout title="CatchID – Fishing Journal & Fish Identification App for Android" description="Build your personal fishing journal with CatchID. Save catches, photos and details, discover Catch Insights, and get optional fish identification help on Android." path="/" pageClass="home-page">
<div class="hero-shell">
<SiteHeader  />
</div>
<main id="main" tabindex="-1">
<div class="hero-shell">
<section class="hero wrap">
<div class="hero-copy">
<p class="eyebrow">YOUR PERSONAL FISHING JOURNAL</p>
<h1>Every catch<br>has a story.<br>
<em>Keep yours.</em>
</h1>
<p class="hero-description">
<span class="desktop-promise">Save your catches, photos and details in one personal journal. Discover records and insights as your fishing history grows.</span>
<span class="mobile-promise">Save catches, photos and details. Discover insights as your journal grows.</span>
</p>
<Download campaign={campaign} priority />
<p class="optional-note">Not sure of the species? <a href="#identify">Get a likely suggestion from a photo.</a>
</p>
</div>
<div class="hero-proof">
<div class="river-photo ">
<HeroPhoto />
</div>
<div class="screen journal-screen ">
<ProductCrop name="journal.jpg" box="75 205 930 1655" width={1080} height={1920} alt="Catch Journal from existing published artwork: saved carp, dace and trout with dates and fishing details." class="" />
</div>
<span class="proof-caption">Your Catch Journal · published example</span>
<span class="art-label">Photo: Patagonia Savage / Pexels</span>
</div>
</section>
<div class="consent-wrap wrap">
<WebAnalyticsConsent />
</div>
</div>
<div class="story-intro wrap">
<p class="eyebrow">YOUR FISHING, REMEMBERED.</p>
<p>A journal that grows more meaningful<br>with every catch.</p>
<span aria-hidden="true">↓</span>
</div>
<ManualEntry />
<JournalStory />
<Insights />
<Identification />
<Trust />
<section class="faq-section" id="questions">
<FAQ />
<div class="final-invite wrap" id="download">
<div>
<p class="eyebrow">YOUR NEXT CATCH IS A BEGINNING</p>
<h2>Keep the catch.<br>
<em>Keep the story.</em>
</h2>
</div>
<Download campaign={campaign}  />
</div>
</section>
</main>
<SiteFooter />
</SiteLayout>
